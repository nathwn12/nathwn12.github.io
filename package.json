{
  "name": "nathwn12-portfolio",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-home.mjs && node scripts/prerender-routes.mjs",
    "typecheck": "tsc -b",
    "test": "bun run build && vitest run",
    "check": "bun run typecheck && bun run test",
    "check:refresh": "bun run typecheck && vitest run tests/npm-downloads.test.ts tests/open-source-stats.test.ts",
    "preview": "vite preview",
    "preview:live": "node scripts/preview.mjs",
    "probe:repos": "node scripts/probe-repos.mjs --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  }
}
