#!/usr/bin/env bash
# [skip ci] is never correct here: CI work is scoped by GitHub path filters
# and the Pages deploy is unfiltered, so the marker can only hide a required
# check or publish a stale site. Refuse it on any path at the push boundary.
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  if git rev-parse --verify --quiet "${remote_sha}^{commit}" >/dev/null 2>&1; then
    commits=$(git rev-list "$remote_sha..$local_sha")
  else
    commits=$(git rev-list "$local_sha" --not --remotes)
  fi

  for sha in $commits; do
    if git log -1 --format=%B "$sha" | grep -Eiq '\[skip ci\]'; then
      printf 'BLOCKED: %s (%s) carries [skip ci]\n' \
        "$(git rev-parse --short "$sha")" "$(git log -1 --format=%s "$sha")" >&2
      printf 'Reason: the marker is never valid; path filters scope CI and the deploy always runs.\n' >&2
      exit 1
    fi
  done
done

echo "?? Checking lockfile is up to date..."
bun install --frozen-lockfile
